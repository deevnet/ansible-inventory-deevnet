#!/usr/bin/env bash
# Prevent committing unencrypted vault files
#
# --diff-filter=ACM restricts this to paths that still exist in the index:
# added, copied, modified. Without it a deletion is listed too, `git show ":$f"`
# fails on the missing path, and the hook rejects a commit that removes a vault
# file - which is exactly what retiring an inventory directory has to do.
FAIL=0
for f in $(git diff --cached --name-only --diff-filter=ACM | grep 'vault\.yml$'); do
    if ! git show ":$f" | head -1 | grep -q '^\$ANSIBLE_VAULT'; then
        echo "ERROR: $f is not encrypted. Run 'make vault' before committing."
        FAIL=1
    fi
done
# An example vault must never carry a value. Every key is empty ("") or a
# mapping of empty keys; anything else is a secret on its way to a public repo.
for f in $(git diff --cached --name-only --diff-filter=ACM | grep 'vault\.example\.yml$'); do
    bad=$(git show ":$f" | awk '/^[[:space:]]*#/ {next}
        /^[[:space:]]*[A-Za-z_][A-Za-z0-9_-]*:[[:space:]]*[^[:space:]]/ && !/:[[:space:]]*""[[:space:]]*$/ {n++}
        END {print n+0}')
    if [ "$bad" -gt 0 ]; then
        echo "ERROR: $f has a non-empty value. Example vaults hold keys only."
        FAIL=1
    fi
done
exit $FAIL
